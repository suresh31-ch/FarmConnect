# ==============================================================================
# FarmConnect AI - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables
# in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Required for AI Crop Doctor disease detection, SURI Voice Assistant,
# Krishi Chat Assistant, Smart Pricing, and Crop Calendar intelligence.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults are optimized for speed and accuracy)
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Supabase Integration Credentials
# ------------------------------------------------------------------------------
# Required for Real Database persistence (Products, Workers, Equipment, Orders,
# Livestock listings, Voice logs) and Supabase Authentication (Email & Phone OTP).
# Obtain these from your Supabase Dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 3. Server Configuration (Local / Production)
# ------------------------------------------------------------------------------
# PORT=3000
# NODE_ENV=production
