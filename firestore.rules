rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /worker_jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    match /advisories/{advisoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
