{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile information and role badges",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
