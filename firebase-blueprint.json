      "title": "Knowledge & Advisories",
      "description": "Crop guides and farming best practices",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "crop": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
