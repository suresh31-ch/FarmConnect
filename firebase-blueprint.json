        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "listings": {
      "title": "Produce Listings",
      "description": "Farm produce available for purchase in marketplace",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "quantity": { "type": "number" },
        "location": { "type": "string" },
        "qualityGrade": { "type": "string" },
        "imageUrl": { "type": "string" },
        "organic": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "farmerId", "price", "unit"]
    },
    "orders": {
      "title": "Orders & Escrow",
      "description": "Produce transaction records with escrow payment status",
      "type": "object",
